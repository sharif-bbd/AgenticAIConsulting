# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Tavily Web Search API (https://app.tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: override default model names.
# Sonnet is used for research, discovery, and output (formatting) agents.
# Opus is used for drafting, framework, and adversarial agents — the
# generative/judgement-heavy steps and the critique loop.
SONNET_MODEL=claude-sonnet-4-6
OPUS_MODEL=claude-opus-4-7
